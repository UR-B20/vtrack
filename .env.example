# VTrack — environment template (CLAUDE.md §7)
# Copy the block you need; never commit a filled-in .env.

# ---------------------------------------------------------------------------
# apps/web/.env        the browser bundle — anon key only, no secrets ever
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The gate this display belongs to. The /display Realtime subscription filters on it,
# so it must match the `site` on the events you expect to see.
# Must be gate1 to see the engine's events: they take their site from the camera's row in
# `devices`, which seed.sql puts at gate1. (M0's optional dev policy used devlab.)
VITE_SITE=gate1
VITE_LANE=A
VITE_DEVICE_ID=display-b

# Leave EMPTY — the app does not read it. Each device is paired from its own screen and keeps
# its token in that browser's storage. Anything VITE_* is compiled into public JavaScript, so
# vite.config.ts refuses a production build while this is set, in case anything ever did.
VITE_DEVICE_TOKEN=

# M1: http://localhost:8000 (the engine on this laptop)  ·  M2: https://vtrack-engine-….onrender.com
# (Pages reads this from the GitHub repo variable VITE_ENGINE_URL, not from this file)
# Unset, the engine pill reads "NOT SET" — an absence, not an outage. Set, it reports what the
# engine's /health actually says.
VITE_ENGINE_URL=

# ---------------------------------------------------------------------------
# services/engine/.env      The engine's secrets. Never committed; host secrets in M2.
# ---------------------------------------------------------------------------
SUPABASE_URL=
# The SECRET key (sb_secret_…): Supabase → Settings → API Keys → Secret keys. Not the
# publishable key — the engine refuses that at startup and /health says so.
SUPABASE_SERVICE_KEY=
ALPR_ENGINE=local
PLATERECOGNIZER_TOKEN=
# One token per device, at least 16 characters. The engine refuses these placeholders.
# Generate each with:  uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
DEVICE_TOKENS={"cam-a":"<random 32 chars>","display-b":"<random 32 chars>"}
CONF_DECIDE=0.85
CONF_CHECK=0.60
DEDUPE_S=15
REPAIR_MAX_SUBS=2
REGION=sg
RATE_LIMIT_PER_S=5
# A frame older (or newer) than this is refused, so a delayed frame of the car that just
# left can never be decided as the car now at the gate.
MAX_FRAME_AGE_S=10
ALLOWED_ORIGINS=http://localhost:5173,https://ur-b20.github.io
